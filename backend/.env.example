# Server Configuration
PORT=5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/CampusPulse?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/CampusPulse
MONGODB_URI=mongodb://127.0.0.1:27017/CampusPulse

# Authentication Secret
JWT_SECRET=campuspulse_super_secret_jwt_key_2026

# Optional: Google OAuth
GOOGLE_CLIENT_ID=

# Optional: Nodemailer Email Service Configuration
EMAIL_USER=
EMAIL_PASS=
